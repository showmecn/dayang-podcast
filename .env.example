# === Database ===
DATABASE_URL=postgresql+asyncpg://dayang:dayang@localhost:5432/dayang

# === LLM Provider (DeepSeek only — company policy, no OpenAI) ===
LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-chat
DEEPSEEK_API_KEY=sk-your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# === Local Embedding (sentence-transformers, no API key) ===
EMBEDDING_MODEL=all-MiniLM-L6-v2

# === Podcast Index (optional, for data ingestion) ===
PODCAST_INDEX_API_KEY=your-podcast-index-api-key
PODCAST_INDEX_API_SECRET=your-podcast-index-api-secret

# === Redis (optional — app works without it, just no caching) ===
REDIS_URL=redis://localhost:6379/0

# === App ===
APP_NAME=Dayang Podcast
APP_VERSION=0.1.0
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
